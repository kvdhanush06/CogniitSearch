# ==============================================================================
# CogniitSearch — Frontend Environment Variables
# ==============================================================================
# Copy to frontend/.env and fill in the actual values.
# Frontend env vars MUST be prefixed with VITE_ to be exposed to the client.
# Only public values go here — never secrets.
# ==============================================================================

# API base URL.
#   In dev:        http://localhost:4000   (Vite hits the backend directly)
#   In production: empty                    (nginx on the host serves the SPA
#                                           and proxies /api/* to the backend)
VITE_API_URL=http://localhost:4000

# Path prefix that the backend mounts all routes under.
VITE_API_PREFIX=/api/v1

# Public origin of this frontend. Used to construct OAuth redirect URLs
# from the UI and shown in error toasts.
#   In dev:        http://localhost:5173
#   In production: https://cogniitsearch.allkvd.dev
VITE_APP_URL=http://localhost:5173

# Socket.IO base (kept for parity; not in the current request path).
VITE_SOCKET_URL=http://localhost:4000

# Display-only metadata.
VITE_APP_NAME=CogniitSearch
VITE_APP_VERSION=1.0.0
