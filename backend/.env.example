# ==============================================================================
# CogniitSearch — Backend Environment Variables
# ==============================================================================
# Copy to backend/.env and fill in the actual values.
# All required keys (no defaults) will crash the backend at boot if missing.
# Where to get each key: see README.md or the deployment guide.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# Redis (BullMQ broker + app cache)
#   In the Linode deploy, set REDIS_HOST=127.0.0.1 because Redis runs as a
#   sibling container exposed only on localhost.
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=1000

# ------------------------------------------------------------------------------
# Supabase (DB + Auth)
#   SERVICE_ROLE_KEY is the privileged key — it must NEVER reach the frontend.
#   ANON_KEY is the public key. JWT_SECRET is used to verify Supabase JWTs.
#   Get all three: Supabase Dashboard → Project Settings → API.
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ------------------------------------------------------------------------------
# Groq (LLM)
#   Free tier is generous. Sign up at https://console.groq.com/.
# ------------------------------------------------------------------------------
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=4096
GROQ_TEMPERATURE=0.7
GROQ_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# Tinyfish (search + crawl)
#   Sign up at https://tinyfish.io/ and copy the API key from the dashboard.
# ------------------------------------------------------------------------------
TINYFISH_API_KEY=your-tinyfish-api-key
TINYFISH_SEARCH_URL=https://api.tinyfish.io/v1/search
TINYFISH_CRAWL_URL=https://api.tinyfish.io/v1/crawl
TINYFISH_TIMEOUT_MS=15000
TINYFISH_MAX_RESULTS=10

# ------------------------------------------------------------------------------
# Auth (backend-mediated Google OAuth via Supabase)
#   SESSION_SECRET: 32+ random chars; signs the session cookie.
#   GOOGLE_OAUTH_REDIRECT_URI: the BACKEND's callback URL that Supabase calls
#                              after Google — must match the redirect URL you
#                              added in Supabase Auth settings.
#   FRONTEND_PUBLIC_URL: where the callback 302s the user on success.
#   COOKIE_SECURE: must be "true" in production (HTTPS).
#   COOKIE_DOMAIN: leave empty unless you're serving api.cogniitsearch.allkvd.dev on
#                  a different origin than the SPA.
#   COOKIE_SAMESITE: "lax" works for the OAuth flow; "none" only with HTTPS.
# ------------------------------------------------------------------------------
SESSION_SECRET=replace-with-at-least-32-random-characters-please
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/auth/callback
FRONTEND_PUBLIC_URL=http://localhost:5173
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_MAX_AGE_MS=604800000
SESSION_COOKIE_NAME=sb-session

# ------------------------------------------------------------------------------
# BullMQ (job queue)
#   USE_BULLMQ=true   → the chat controller enqueues a search → crawl →
#                       answer chain via the Orchestrator. Workers run
#                       alongside the API in the same container.
#   USE_BULLMQ=false  → fallback: services run inline. No Redis required.
# ------------------------------------------------------------------------------
BULLMQ_DEFAULT_ATTEMPTS=3
BULLMQ_BACKOFF_TYPE=exponential
BULLMQ_BACKOFF_DELAY=1000
USE_BULLMQ=true

# ------------------------------------------------------------------------------
# Follow-up generation
#   Small, cheap model used after the main answer streams.
# ------------------------------------------------------------------------------
GROQ_FOLLOWUP_MODEL=llama-3.1-8b-instant

# ------------------------------------------------------------------------------
# Rate limiting (active per-user token bucket)
#   Capacity = burst size; refill = sustained rate per hour.
#   The legacy RATE_LIMIT_*_WINDOW_MS / _MAX_REQUESTS env vars are kept
#   for any callers that still read them; the live limiter uses the
#   bucket.
# ------------------------------------------------------------------------------
RATE_LIMIT_BUCKET_CAPACITY=100
RATE_LIMIT_REFILL_PER_HOUR=100

# ------------------------------------------------------------------------------
# Cache TTLs (in seconds). The defaults match the values in
# `services/cache.service.ts`; override only if you know why.
# ------------------------------------------------------------------------------
CACHE_SEARCH_TTL_SECONDS=3600
CACHE_CONTEXT_TTL_SECONDS=86400

# ------------------------------------------------------------------------------
# Socket.IO (kept for future use; not in the current request path)
# ------------------------------------------------------------------------------
SOCKET_CORS_ORIGIN=http://localhost:5173
SOCKET_PATH=/socket.io
SOCKET_PING_TIMEOUT=60000
SOCKET_PING_INTERVAL=25000
SOCKET_MAX_CONNECTIONS=1000

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=pretty
LOG_FILE_ENABLED=false
LOG_FILE_PATH=./logs/app.log

# ------------------------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_SEARCH_WINDOW_MS=60000
RATE_LIMIT_SEARCH_MAX_REQUESTS=10

# ------------------------------------------------------------------------------
# CORS
#   In dev, CORS_ORIGIN is the Vite dev server.
#   In prod, set to your public frontend origin (https://cogniitsearch.allkvd.dev)
#   and CORS_CREDENTIALS=true so the httpOnly cookie can be set.
# ------------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true
