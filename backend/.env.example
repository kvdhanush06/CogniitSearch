# ==============================================================================
# CogniitSearch — Backend Environment Variables
# ==============================================================================
# Copy to backend/.env and fill in the actual values.

# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api/v1
# Number of trusted reverse-proxy hops. Keep 0 unless the deployment topology
# is known; set to 1 when exactly one trusted proxy sits in front of the app.
TRUST_PROXY=0

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=1000

# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=4096
GROQ_TEMPERATURE=0.7
GROQ_TIMEOUT_MS=30000
GROQ_FOLLOWUP_MODEL=llama-3.1-8b-instant

# Tinyfish
TINYFISH_API_KEY=your-tinyfish-api-key
TINYFISH_SEARCH_URL=https://api.tinyfish.io/v1/search
TINYFISH_CRAWL_URL=https://api.tinyfish.io/v1/crawl
TINYFISH_TIMEOUT_MS=15000
TINYFISH_MAX_RESULTS=10

# Auth
SESSION_SECRET=replace-with-at-least-32-random-characters-please
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/auth/callback
FRONTEND_PUBLIC_URL=http://localhost:5173
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_MAX_AGE_MS=604800000
SESSION_COOKIE_NAME=sb-session

# BullMQ
BULLMQ_DEFAULT_ATTEMPTS=3
BULLMQ_BACKOFF_TYPE=exponential
BULLMQ_BACKOFF_DELAY=1000
USE_BULLMQ=true

# Rate limiting
RATE_LIMIT_BUCKET_CAPACITY=100
RATE_LIMIT_REFILL_PER_HOUR=100
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_SEARCH_WINDOW_MS=60000
RATE_LIMIT_SEARCH_MAX_REQUESTS=10

# Cache
CACHE_SEARCH_TTL_SECONDS=3600
CACHE_CONTEXT_TTL_SECONDS=86400

# Socket.IO
SOCKET_CORS_ORIGIN=http://localhost:5173
SOCKET_PATH=/socket.io
SOCKET_PING_TIMEOUT=60000
SOCKET_PING_INTERVAL=25000
SOCKET_MAX_CONNECTIONS=1000

# Logging
LOG_LEVEL=info
LOG_FORMAT=pretty
LOG_FILE_ENABLED=false
LOG_FILE_PATH=./logs/app.log

# CORS
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true
